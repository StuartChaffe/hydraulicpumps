{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "color": {
            "custom": false,
            "customGradient": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "duotone": [],
            "palette": [
                { "name": "White",      "slug": "white",      "color": "#ffffff" },
                { "name": "Grey",       "slug": "grey",       "color": "#F5F5F5" },
                { "name": "Black",      "slug": "black",      "color": "#000000" },
                { "name": "Navy",       "slug": "navy",       "color": "#013473" },
                { "name": "Red",        "slug": "red",        "color": "#EE3D33" }
            ]
        },
        "layout": {
            "contentSize": "50rem",
            "wideSize": "75rem"
        },
        "spacing": {
            "blockGap": null,
            "customSpacingSize": false,
            "margin": false,
            "padding": false,
            "units": []
        },
        "typography": {
            "customFontSize": false,
            "defaultFontSizes": true,
            "dropCap": false
        }
    }
}
